# Copy to .env and adjust values.
# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Server
PORT=4000
NODE_ENV=development

# CORS: the Vite dev server origin
CLIENT_ORIGIN="http://localhost:5173"

# JWT / auth
JWT_SECRET="dev-only-change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
COOKIE_NAME="interviewly_token"
COOKIE_SECURE="false"

# ── AI question generation ─────────────────────────────────────────
# Leave ANTHROPIC_API_KEY unset to run in mock mode (no key required).
# AI_PROVIDER: "auto" (Claude if key present, else mock), "mock", or "claude".
AI_PROVIDER="auto"
# ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-5"
